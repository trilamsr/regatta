{
  "uid": "regatta-l4-gate",
  "title": "Regatta — L4 Gate Hit-Rate + Latency",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["regatta", "l4", "gates", "wave-a", "tier-1"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      },
      {
        "name": "category",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(regatta_l4_invocations_total, category)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Invocations/sec by verdict",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (verdict) (rate(regatta_l4_invocations_total{category=~\"$category\"}[5m]))",
          "legendFormat": "{{verdict}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99 (ms)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(regatta_l4_latency_ms_bucket{category=~\"$category\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(regatta_l4_latency_ms_bucket{category=~\"$category\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(regatta_l4_latency_ms_bucket{category=~\"$category\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache hit ratio (5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(regatta_l4_cache_hits_total[5m])) / clamp_min(sum(rate(regatta_l4_cache_hits_total[5m]) + rate(regatta_l4_cache_misses_total[5m])), 1)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Second-opinion fire-rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(regatta_l4_second_opinion_fired_total[5m]))",
          "legendFormat": "fires/sec"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Hit-rate by verdict (5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (verdict) (rate(regatta_l4_invocations_total[5m])) / ignoring(verdict) group_left sum(rate(regatta_l4_invocations_total[5m]))",
          "legendFormat": "{{verdict}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Invocations by category (stacked)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "options": { "stacking": { "mode": "normal" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (category) (rate(regatta_l4_invocations_total{category=~\"$category\"}[5m]))",
          "legendFormat": "{{category}}"
        }
      ]
    }
  ]
}
