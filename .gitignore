.claude/*.local.md
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# Local planning artifacts (specs, plans, design notes). Each
# implementer keeps their own; the final state lives in
# docs/engineer/specs/ and docs/rfcs/.
docs/superpowers/

# Go build artifacts
bin/
dist/*
!dist/services/
!dist/cron/
*.test
*.out
coverage.out

# Node toolchain used only for `make build-tailwind`. The compiled
# tailwind.min.css ships under internal/web/static/; node never runs on CI.
node_modules/
package-lock.json
package.json

# Sloth binary cache (downloaded by scripts/slo-compile.sh per
# tools/sloth/version pin; never committed — the pin file is the
# source of truth).
tools/sloth/bin/
