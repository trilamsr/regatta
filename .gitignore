.claude/*.local.md
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# Local planning artifacts (specs, plans, design notes). Each
# implementer keeps their own; the final state lives in
# docs/engineer/specs/ and docs/rfcs/.
docs/superpowers/

# Auto-generated spec index. Regenerate locally with `make specs-index`
# to browse; never tracked because every spec PR would otherwise rewrite
# this anchor and cascade-rebase every other in-flight spec PR.
docs/engineer/specs/README.md

# Go build artifacts
/regatta
bin/
dist/*
!dist/services/
!dist/cron/
*.test
*.out
coverage.out
go.work.sum

# Node toolchain used only for `make build-tailwind`. The compiled
# tailwind.min.css ships under internal/web/static/; node never runs on CI.
node_modules/
package-lock.json
package.json

# SvelteKit operator console under web/console/ keeps its package.json +
# package-lock.json tracked. Only the generated outputs are ignored.
!web/console/package.json
!web/console/package-lock.json
web/console/.svelte-kit/
web/console/build/
web/console/node_modules/

# Sloth binary cache (downloaded by scripts/slo-compile.sh per
# tools/sloth/version pin; never committed — the pin file is the
# source of truth).
tools/sloth/bin/

# Local env file holding secrets (ANTHROPIC_API_KEY, GH_TOKEN, etc).
# Template in .env.example; real values never committed.
.env
.env.*
!.env.example

# Operator-local docker overrides — populated per-operator at runtime, not tracked.
regatta.yaml.operator-runtime
regatta.yaml.operator-runtime.bak
docker-compose.override.yml
