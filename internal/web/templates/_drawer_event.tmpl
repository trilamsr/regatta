{{define "_drawer_event"}}
<div class="drawer-bg" hx-on:click="document.getElementById('drawer-mount').innerHTML=''"></div>
<aside class="drawer">
  <div class="flex items-baseline justify-between">
    <h3>{{.Kind}}</h3>
    <button class="ident text-slate-500 hover:text-slate-900"
            hx-on:click="document.getElementById('drawer-mount').innerHTML=''">close ×</button>
  </div>
  <div class="ident text-xs mt-1">id #{{.ID}} · {{formatTime .CreatedAt}}</div>

  <dt class="ident text-xs uppercase tracking-widest text-slate-500 mt-5">payload</dt>
  <pre class="mt-2 whitespace-pre-wrap text-xs font-mono bg-slate-50 border border-slate-300 p-3 break-all">{{.PayloadJSON}}</pre>
</aside>
{{end}}
