{{define "_drawer_workitem"}}
<div class="drawer-bg" hx-on:click="document.getElementById('drawer-mount').innerHTML=''"></div>
<aside class="drawer">
  <div class="flex items-baseline justify-between">
    <h3>{{.Title}}</h3>
    <button class="ident text-slate-500 hover:text-slate-900"
            hx-on:click="document.getElementById('drawer-mount').innerHTML=''">close ×</button>
  </div>
  <div class="ident text-xs mt-1">
    {{.ID}} · {{.Kind}} · lane {{.Lane}}
    {{- if .IssueURL}}
    · <a class="text-blue-700 hover:underline" href="{{.IssueURL}}" target="_blank" rel="noopener noreferrer">view on github</a>
    {{- end}}
  </div>

  {{- if .StatusFlow}}
  <ol class="status-flow mt-3 flex gap-1 text-xs">
  {{- range .StatusFlow}}
    <li class="flow-step px-2 py-1 border border-slate-300 rounded {{if .Active}}active bg-slate-900 text-white border-slate-900{{else}}text-slate-500{{end}}">{{.Label}}</li>
  {{- end}}
  </ol>
  {{- end}}

  <dl class="mt-4">
    <dt>status</dt><dd>{{.StatusLabel}}</dd>
    <dt>source</dt><dd>{{.Source}}</dd>
    <dt>updated</dt><dd>{{formatTime .UpdatedAt}}</dd>
    {{- if .DependsOnFeatures}}
    <dt>depends on</dt>
    <dd>{{range .DependsOnFeatures}}<span class="ident block">{{.}}</span>{{end}}</dd>
    {{- end}}
    {{- if .ParentProgramID}}<dt>parent</dt><dd>{{.ParentProgramID}}</dd>{{- end}}
  </dl>

  {{- if .BodyPreview}}
  <dt class="ident text-xs uppercase tracking-widest text-slate-500 mt-5">body preview</dt>
  <p class="mt-2 whitespace-pre-wrap text-xs text-slate-700">{{.BodyPreview}}</p>
  {{- end}}

  {{- if .Acceptance}}
  <dt class="ident text-xs uppercase tracking-widest text-slate-500 mt-5">acceptance</dt>
  <pre class="mt-2 whitespace-pre-wrap text-xs font-mono bg-slate-50 border border-slate-300 p-3">{{.Acceptance}}</pre>
  {{- end}}

  {{- if .RecentEvents}}
  <dt class="ident text-xs uppercase tracking-widest text-slate-500 mt-5">recent events</dt>
  <ul class="mt-2 divide-y divide-slate-200 border border-slate-300">
  {{- range .RecentEvents}}
    <li class="px-2 py-1 text-xs font-mono">
      <span class="text-slate-500">{{relTime .CreatedAt}}</span>
      <span class="ml-2 text-slate-900">{{.Kind}}</span>
    </li>
  {{- end}}
  </ul>
  {{- end}}
</aside>
{{end}}
