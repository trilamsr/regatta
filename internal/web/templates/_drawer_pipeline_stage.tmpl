{{define "_drawer_pipeline_stage"}}
<div class="drawer-bg"></div>
<aside class="drawer">
  <div class="flex items-baseline justify-between">
    <h3>{{.Owner}} · {{.Label}}</h3>
    <button class="ident text-slate-500 hover:text-slate-900 drawer-close">close ×</button>
  </div>
  <div class="ident text-xs mt-1">stage: {{.Slug}} · {{len .Items}} item(s)</div>
  {{- if .Err}}
  <div class="empty-state mt-4" data-degraded>stage unavailable — {{.Err}}</div>
  {{- else if .Items}}
  <div class="mt-4">
    <div class="row row-grid-pipeline-drawer text-xs font-mono text-slate-500 uppercase tracking-widest">
      <span>work item</span>
      <span>lane</span>
      <span class="text-right">agent</span>
      <span class="text-right">age</span>
    </div>
    {{- range .Items}}
    <div class="row row-grid-pipeline-drawer">
      <span class="ident truncate" title="{{.WorkItemID}}">{{.WorkItemID}}</span>
      <span class="ident">{{.Lane}}</span>
      <span class="ident text-right">{{if .AgentID}}#{{.AgentID}}{{else}}—{{end}}</span>
      <span class="ident text-right">{{.Age}}</span>
    </div>
    {{- end}}
  </div>
  {{- else}}
  <div class="empty-state mt-4">no items at this stage</div>
  {{- end}}
</aside>
{{end}}
