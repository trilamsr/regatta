<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>regatta · operator</title>
<link rel="icon" type="image/svg+xml" href="/ui/static/favicon.svg">
<link rel="preload" href="/ui/static/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/ui/static/tailwind.min.css">
<link rel="stylesheet" href="/ui/static/dashboard.css">
<script src="/ui/static/htmx.min.js" defer></script>
<script src="/ui/static/htmx-config.js" defer></script>
<script src="/ui/static/drawer-close.js" defer></script>
</head>
<body class="min-h-screen">

<header class="topbar">
  <div class="dash-main mx-auto flex items-center justify-between px-6 py-3">
    <div class="flex items-baseline gap-4">
      <span class="brand text-xl">regatta</span>
      <span class="ticker text-slate-500">operator · {{formatTime .Now}}</span>
    </div>
    <div class="ticker text-slate-600 flex gap-4">
      <span>STATUS: <span class="text-emerald-700">●&nbsp;LIVE</span></span>
    </div>
  </div>
</header>

<main class="dash-main mx-auto px-6 py-10">

  <section>
    <div class="section-head">
      <span class="title">Pipeline</span>
      <span class="meta">click stage for items</span>
    </div>
    <div id="pipeline-panel" hx-get="/ui/panels/pipeline" hx-trigger="load, every 5s" hx-swap="innerHTML">
      <div class="panel p-6 text-sm text-slate-500">loading…</div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <span class="title">Health</span>
      <span class="meta">tick + exit reasons</span>
    </div>
    <div id="health-panel" hx-get="/ui/panels/health" hx-trigger="load, every 5s" hx-swap="innerHTML">
      <div class="panel p-6 text-sm text-slate-500">loading…</div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <span class="title">Agents</span>
      <span class="meta">click row for detail</span>
    </div>
    <div id="agents-panel" hx-get="/ui/panels/agents" hx-trigger="load, every 5s" hx-swap="innerHTML">
      <div class="panel p-6 text-sm text-slate-500">loading…</div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <span class="title">Flow</span>
      <span class="meta">stage → stage</span>
    </div>
    <div id="flow-panel" hx-get="/ui/panels/flow" hx-trigger="load, every 10s" hx-swap="innerHTML">
      <div class="panel p-6 text-sm text-slate-500">loading…</div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <span class="title">Backlog</span>
      <span class="meta">click for body</span>
    </div>
    <div id="work-items-panel" hx-get="/ui/panels/work-items" hx-trigger="load, every 10s" hx-swap="innerHTML">
      <div class="panel p-6 text-sm text-slate-500">loading…</div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <span class="title">Activity</span>
      <span class="meta">live</span>
    </div>
    <div id="events-panel" hx-get="/ui/panels/events" hx-trigger="load, every 5s" hx-swap="innerHTML">
      <div class="panel p-6 text-sm text-slate-500">loading…</div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <span class="title">Spend today</span>
      <span class="meta">substrate · usd</span>
    </div>
    <div id="spend-panel" hx-get="/ui/panels/spend" hx-trigger="load, every 30s" hx-swap="innerHTML">
      <div class="panel p-6 text-sm text-slate-500">loading…</div>
    </div>
  </section>

</main>

<div id="drawer-mount"></div>

</body>
</html>
