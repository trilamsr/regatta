{{define "_docker_soak"}}
<div class="panel p-4 text-sm">
<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
<div>
  <div class="lbl text-xs uppercase tracking-widest text-slate-500">Uptime</div>
  <div class="val font-mono text-base">{{.Uptime}}</div>
</div>
<div>
  <div class="lbl text-xs uppercase tracking-widest text-slate-500">Health</div>
  <div class="val font-mono text-base"><span class="pill pill-soak-{{.Health}}">{{.HealthLabel}}</span></div>
</div>
<div>
  <div class="lbl text-xs uppercase tracking-widest text-slate-500">Last 1m spawns / exits</div>
  <div class="val font-mono text-base">{{.SpawnsLast1m}} / {{.ExitedLast1m}}</div>
</div>
<div>
  <div class="lbl text-xs uppercase tracking-widest text-slate-500">Last exit</div>
  <div class="val font-mono text-base">
  {{- if .HasLastExit -}}
    {{.LastExitReason}}{{.LastExitBadge}}
  {{- else -}}
    <span class="text-slate-500">—</span>
  {{- end -}}
  </div>
</div>
</div>
</div>
{{end}}
