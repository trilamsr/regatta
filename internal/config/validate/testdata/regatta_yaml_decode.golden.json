{
  "repo": {
    "host": "github",
    "owner": "trilamsr",
    "name": "regatta",
    "default_branch": "main"
  },
  "work_item_source": {
    "type": "github_issues",
    "selector": "label:autonomous",
    "acceptance_section": "## Acceptance criteria",
    "default_lane": "self-host"
  },
  "safety": {
    "destructive_ops_deny": [
      "rm -rf /",
      "git push --force"
    ],
    "agent_destructive_ops_allow": [
      "git push --force-with-lease origin regatta/agent-"
    ]
  },
  "scheduler": {
    "parallel_cap": 5
  }
}
