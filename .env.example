# Regatta container env template. Copy to `.env` and fill in real values.
# `.env` is gitignored; never commit secrets.

# --- Required ---

# Anthropic API key — Claude planner + L4 adapter.
# Provision at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=sk-ant-...

# GitHub token consumed by the `gh` CLI (spawner shells to `gh` for PR ops).
# Needs `repo` + `workflow` scopes on the target repository.
GH_TOKEN=ghp_...

# --- Optional ---

# HMAC keyring for brief envelopes. Format: `kid:secret[,kid:secret...]`.
# Leave unset for single-tenant local dev; required once briefs cross a trust
# boundary. See docs/operator/rbac-onboarding.md for rotation procedure.
# REGATTA_BRIEF_HMAC_KEYS=v1:replace-with-32-byte-secret
