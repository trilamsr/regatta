{
  "gopls": {
    "directoryFilters": [
      "-.claude/worktrees",
      "-triage-",
      "-vendor",
      "-node_modules"
    ],
    "expandWorkspaceToModule": false
  },
  "files.watcherExclude": {
    "**/.claude/worktrees/**": true,
    "**/.git/objects/**": true
  },
  "search.exclude": {
    "**/.claude/worktrees": true
  }
}
